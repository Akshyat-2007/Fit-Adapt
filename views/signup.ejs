<%- include('partials/header', { title: 'Sign Up & Condition Profile' }) %>
<%- include('partials/nav', { activeNav: 'signup' }) %>

<main class="flex-grow flex items-center justify-center px-4 py-12">
  <div class="max-w-xl w-full bg-white dark:bg-gray-800 rounded-3xl p-8 border border-gray-200 dark:border-gray-700 shadow-xl space-y-6">
    
    <div class="text-center space-y-2">
      <div class="w-12 h-12 rounded-2xl bg-brand-50 dark:bg-brand-950/60 text-brand-600 dark:text-brand-400 flex items-center justify-center mx-auto shadow-inner">
        <i data-lucide="user-plus" class="w-6 h-6"></i>
      </div>
      <h2 class="text-2xl font-extrabold text-gray-900 dark:text-white">Create Your Profile</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400">Personalize your fitness safety boundaries from day one</p>
    </div>

    <form id="signupForm" onsubmit="handleSignup(event)" class="space-y-5">
      <div id="errorMessage" class="hidden p-3 rounded-xl bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 text-xs font-medium border border-rose-200 dark:border-rose-900"></div>

      <!-- Account Details -->
      <div class="space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400 border-b border-gray-100 dark:border-gray-700 pb-1">1. Account Details</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Full Name</label>
            <input type="text" id="name" required placeholder="e.g. Maya Patel" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-brand-500 focus:outline-none text-sm">
          </div>
          <div>
            <label for="email" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Email Address</label>
            <input type="email" id="email" required placeholder="maya@example.com" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-brand-500 focus:outline-none text-sm">
          </div>
        </div>

        <div>
          <label for="password" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Password</label>
          <input type="password" id="password" required minlength="6" placeholder="At least 6 characters" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-brand-500 focus:outline-none text-sm">
        </div>
      </div>

      <!-- Condition Profile Details (Phase 2 requirement) -->
      <div class="space-y-4 pt-2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400 border-b border-gray-100 dark:border-gray-700 pb-1">2. Invisible Health Condition</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="condition_type" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Condition Profile</label>
            <select id="condition_type" required class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-brand-500 focus:outline-none text-sm">
              <option value="asthma">Asthma / Respiratory</option>
              <option value="joint">Joint / Arthritis / Hypermobility</option>
              <option value="pcos">PCOS / Hormonal Condition</option>
              <option value="postnatal">Postnatal Recovery / Diastasis</option>
              <option value="anxiety_fatigue">Anxiety-Linked Chronic Fatigue</option>
              <option value="other">Other / Multi-Condition</option>
            </select>
          </div>

          <div>
            <label for="severity" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Severity Rating</label>
            <select id="severity" required class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-brand-500 focus:outline-none text-sm">
              <option value="mild">Mild (Infrequent symptoms)</option>
              <option value="moderate" selected>Moderate (Routine management)</option>
              <option value="significant">Significant (Sensitive to overexertion)</option>
            </select>
          </div>
        </div>

        <div>
          <label for="notes" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Personal Triggers / Pacing Notes (Optional)</label>
          <textarea id="notes" rows="2" placeholder="e.g., Cold weather triggers wheezing; knees prone to flare-ups on high impacts..." class="w-full px-4 py-2 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-brand-500 focus:outline-none text-sm"></textarea>
        </div>
      </div>

      <button type="submit" id="submitBtn" class="w-full py-3.5 px-4 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm shadow-md shadow-brand-600/30 transition flex items-center justify-center gap-2">
        <span>Create Profile & Calibrate</span>
        <i data-lucide="arrow-right" class="w-4 h-4"></i>
      </button>
    </form>

    <div class="text-center text-xs text-gray-500 dark:text-gray-400 pt-2 border-t border-gray-100 dark:border-gray-700">
      Already have an account? 
      <a href="/login" class="text-brand-600 dark:text-brand-400 font-bold hover:underline">Log In</a>
    </div>

  </div>
</main>

<script>
  async function handleSignup(e) {
    e.preventDefault();
    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;
    const condition_type = document.getElementById('condition_type').value;
    const severity = document.getElementById('severity').value;
    const notes = document.getElementById('notes').value.trim();

    const errorDiv = document.getElementById('errorMessage');
    const submitBtn = document.getElementById('submitBtn');

    errorDiv.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span>Setting up profile...</span>';

    try {
      const res = await fetch('/api/auth/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, password, condition_type, severity, notes })
      });
      const data = await res.json();

      if (data.success) {
        showToast('Profile created successfully!', 'success');
        setTimeout(() => {
          window.location.href = '/checkin';
        }, 500);
      } else {
        errorDiv.innerText = data.error || 'Failed to sign up.';
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Create Profile & Calibrate</span><i data-lucide="arrow-right" class="w-4 h-4"></i>';
        lucide.createIcons();
      }
    } catch (err) {
      errorDiv.innerText = 'Network error. Please try again.';
      errorDiv.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<span>Create Profile & Calibrate</span><i data-lucide="arrow-right" class="w-4 h-4"></i>';
      lucide.createIcons();
    }
  }
</script>

<%- include('partials/footer') %>
