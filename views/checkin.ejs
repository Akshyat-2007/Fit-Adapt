<%- include('partials/header', { title: 'Daily Symptom Check-in' }) %>
<%- include('partials/nav', { activeNav: 'checkin' }) %>

<main class="flex-grow max-w-2xl mx-auto px-4 sm:px-6 py-10 w-full">
  <div class="bg-white dark:bg-gray-800 rounded-3xl p-6 sm:p-10 border border-gray-200 dark:border-gray-700 shadow-xl space-y-8">
    
    <!-- Title & Date -->
    <div class="flex items-center justify-between border-b border-gray-100 dark:border-gray-700 pb-5">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">Daily Health Calibration</span>
        <h1 class="text-2xl font-black text-gray-900 dark:text-white mt-0.5">Symptom Check-in</h1>
      </div>
      <div id="checkinBadge" class="text-xs font-semibold px-3 py-1.5 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">
        Today's Date
      </div>
    </div>

    <!-- Checkin Form -->
    <form id="checkinForm" onsubmit="handleCheckinSubmit(event)" class="space-y-9">

      <!-- 1. Flare-up Safety Toggle (High priority safety first) -->
      <div class="p-5 rounded-2xl bg-amber-50/70 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/40 space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-900/60 text-amber-700 dark:text-amber-300 flex items-center justify-center">
              <i data-lucide="flame" class="w-5 h-5"></i>
            </div>
            <div>
              <label for="flare_flag" class="text-sm font-bold text-gray-900 dark:text-white block cursor-pointer">Active Flare-Up Today?</label>
              <p class="text-xs text-gray-500 dark:text-gray-400">Marking this will safely adapt today's routine to restorative breathing and gentle recovery.</p>
            </div>
          </div>
          <!-- Toggle switch -->
          <label class="relative inline-flex items-center cursor-pointer shrink-0">
            <input type="checkbox" id="flare_flag" class="sr-only peer">
            <div class="w-11 h-6 bg-gray-300 peer-focus:outline-none rounded-full peer dark:bg-gray-600 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-amber-600"></div>
          </label>
        </div>
      </div>

      <!-- 2. Physical Energy Level (1, 2, 3, 4, 5) -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="energy_level" class="text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2">
            <i data-lucide="battery-charging" class="w-4 h-4 text-emerald-500"></i>
            <span>Physical Energy Level</span>
          </label>
          <span id="energyValue" class="text-xs sm:text-sm font-bold px-3 py-1 rounded-xl bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 transition-colors">
            3 — Moderate Energy
          </span>
        </div>

        <div class="pt-1">
          <!-- Range Slider -->
          <input type="range" id="energy_level" min="1" max="5" step="1" value="3" oninput="updateSliderLabels()" class="slider-emerald">

          <!-- Perfectly Aligned Numbers 1, 2, 3, 4, 5 and Step Indicators -->
          <div class="slider-steps-track relative h-14 mt-1.5">
            
            <!-- Step 1 (0%) -->
            <button type="button" onclick="setSlider('energy_level', 1)" class="energy-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 0%;">
              <div class="w-1 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm" data-val="1">1</span>
              <span class="text-[10px] text-gray-500 dark:text-gray-400 font-medium mt-1">Depleted</span>
            </button>

            <!-- Step 2 (25%) -->
            <button type="button" onclick="setSlider('energy_level', 2)" class="energy-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 25%;">
              <div class="w-1 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm" data-val="2">2</span>
              <span class="text-[10px] text-gray-500 dark:text-gray-400 font-medium mt-1">Low</span>
            </button>

            <!-- Step 3 (50%) -->
            <button type="button" onclick="setSlider('energy_level', 3)" class="energy-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 50%;">
              <div class="w-1 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm" data-val="3">3</span>
              <span class="text-[10px] text-gray-500 dark:text-gray-400 font-medium mt-1">Moderate</span>
            </button>

            <!-- Step 4 (75%) -->
            <button type="button" onclick="setSlider('energy_level', 4)" class="energy-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 75%;">
              <div class="w-1 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm" data-val="4">4</span>
              <span class="text-[10px] text-gray-500 dark:text-gray-400 font-medium mt-1">Good</span>
            </button>

            <!-- Step 5 (100%) -->
            <button type="button" onclick="setSlider('energy_level', 5)" class="energy-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 100%;">
              <div class="w-1 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm" data-val="5">5</span>
              <span class="text-[10px] text-gray-500 dark:text-gray-400 font-medium mt-1">Vitality</span>
            </button>

          </div>
        </div>
      </div>

      <!-- 3. Pain & Discomfort Level (1, 2, 3, 4, 5) -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="pain_level" class="text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2">
            <i data-lucide="shield-alert" class="w-4 h-4 text-rose-500"></i>
            <span>Pain & Discomfort Level</span>
          </label>
          <span id="painValue" class="text-xs sm:text-sm font-bold px-3 py-1 rounded-xl bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-650 transition-colors">
            1 — None / Minimal
          </span>
        </div>

        <div class="pt-1">
          <!-- Range Slider -->
          <input type="range" id="pain_level" min="1" max="5" step="1" value="1" oninput="updateSliderLabels()" class="slider-rose">

          <!-- Perfectly Aligned Numbers 1, 2, 3, 4, 5 and Step Indicators -->
          <div class="slider-steps-track relative h-14 mt-1.5">
            
            <!-- Step 1 (0%) -->
            <button type="button" onclick="setSlider('pain_level', 1)" class="pain-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 0%;">
              <div class="w-1 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm" data-val="1">1</span>
              <span class="text-[10px] text-gray-500 dark:text-gray-400 font-medium mt-1">None</span>
            </button>

            <!-- Step 2 (25%) -->
            <button type="button" onclick="setSlider('pain_level', 2)" class="pain-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 25%;">
              <div class="w-1 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm" data-val="2">2</span>
              <span class="text-[10px] text-gray-500 dark:text-gray-400 font-medium mt-1">Mild</span>
            </button>

            <!-- Step 3 (50%) -->
            <button type="button" onclick="setSlider('pain_level', 3)" class="pain-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 50%;">
              <div class="w-1 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm" data-val="3">3</span>
              <span class="text-[10px] text-gray-500 dark:text-gray-400 font-medium mt-1">Moderate</span>
            </button>

            <!-- Step 4 (75%) -->
            <button type="button" onclick="setSlider('pain_level', 4)" class="pain-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 75%;">
              <div class="w-1 h-1.5 rounded-full bg-rose-400 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm text-rose-500" data-val="4">4</span>
              <span class="text-[10px] text-rose-500 font-bold mt-1">Rest</span>
            </button>

            <!-- Step 5 (100%) -->
            <button type="button" onclick="setSlider('pain_level', 5)" class="pain-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 100%;">
              <div class="w-1 h-1.5 rounded-full bg-rose-500 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm text-rose-600" data-val="5">5</span>
              <span class="text-[10px] text-rose-600 font-bold mt-1">Severe</span>
            </button>

          </div>
        </div>
      </div>

      <!-- 4. Shortness of Breath / Respiration (1, 2, 3, 4, 5) -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="breathlessness" class="text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2">
            <i data-lucide="wind" class="w-4 h-4 text-cyan-500"></i>
            <span>Shortness of Breath / Respiration</span>
          </label>
          <span id="breathValue" class="text-xs sm:text-sm font-bold px-3 py-1 rounded-xl bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-650 transition-colors">
            1 — Normal / Clear
          </span>
        </div>

        <div class="pt-1">
          <!-- Range Slider -->
          <input type="range" id="breathlessness" min="1" max="5" step="1" value="1" oninput="updateSliderLabels()" class="slider-cyan">

          <!-- Perfectly Aligned Numbers 1, 2, 3, 4, 5 and Step Indicators -->
          <div class="slider-steps-track relative h-14 mt-1.5">
            
            <!-- Step 1 (0%) -->
            <button type="button" onclick="setSlider('breathlessness', 1)" class="breath-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 0%;">
              <div class="w-1 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm" data-val="1">1</span>
              <span class="text-[10px] text-gray-500 dark:text-gray-400 font-medium mt-1">Clear</span>
            </button>

            <!-- Step 2 (25%) -->
            <button type="button" onclick="setSlider('breathlessness', 2)" class="breath-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 25%;">
              <div class="w-1 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm" data-val="2">2</span>
              <span class="text-[10px] text-gray-500 dark:text-gray-400 font-medium mt-1">Slight</span>
            </button>

            <!-- Step 3 (50%) -->
            <button type="button" onclick="setSlider('breathlessness', 3)" class="breath-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 50%;">
              <div class="w-1 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm" data-val="3">3</span>
              <span class="text-[10px] text-gray-500 dark:text-gray-400 font-medium mt-1">Moderate</span>
            </button>

            <!-- Step 4 (75%) -->
            <button type="button" onclick="setSlider('breathlessness', 4)" class="breath-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 75%;">
              <div class="w-1 h-1.5 rounded-full bg-cyan-400 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm text-cyan-600 dark:text-cyan-400" data-val="4">4</span>
              <span class="text-[10px] text-cyan-600 dark:text-cyan-400 font-bold mt-1">Rest</span>
            </button>

            <!-- Step 5 (100%) -->
            <button type="button" onclick="setSlider('breathlessness', 5)" class="breath-step-btn absolute top-0 -translate-x-1/2 flex flex-col items-center group cursor-pointer" style="left: 100%;">
              <div class="w-1 h-1.5 rounded-full bg-cyan-500 mb-1"></div>
              <span class="step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm text-cyan-600 dark:text-cyan-400" data-val="5">5</span>
              <span class="text-[10px] text-cyan-600 dark:text-cyan-400 font-bold mt-1">Severe</span>
            </button>

          </div>
        </div>
      </div>

      <!-- Submit Action -->
      <div class="pt-3 border-t border-gray-100 dark:border-gray-700">
        <button type="submit" id="checkinBtn" class="w-full py-4 px-6 rounded-2xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-base shadow-lg shadow-brand-600/25 transition flex items-center justify-center gap-2">
          <i data-lucide="sparkles" class="w-5 h-5"></i>
          <span>Calibrate Today's Workout</span>
        </button>
        <p class="text-center text-xs text-gray-400 dark:text-gray-500 mt-2.5">
          Inputs are processed instantly by the FitAdapt Adaptive Rule Engine (Section 8)
        </p>
      </div>

    </form>
  </div>
</main>

<script>
  const energyMap = {
    1: '1 — Very Low (Exhausted)',
    2: '2 — Low Energy',
    3: '3 — Moderate Energy',
    4: '4 — Good Energy',
    5: '5 — High Vitality'
  };

  const painMap = {
    0: '1 — None / Minimal',
    1: '1 — None / Minimal',
    2: '2 — Mild Aches',
    3: '3 — Noticeable Pain',
    4: '4 — Significant Pain (Triggers Rest)',
    5: '5 — Severe Acute Pain (Triggers Rest)'
  };

  const breathMap = {
    0: '1 — Normal / Clear',
    1: '1 — Normal / Clear',
    2: '2 — Slight Tightness',
    3: '3 — Moderate Breathlessness',
    4: '4 — Significant Labored Breathing (Triggers Rest)',
    5: '5 — Severe Breathlessness (Triggers Rest)'
  };

  function setSlider(sliderId, val) {
    const slider = document.getElementById(sliderId);
    if (slider) {
      slider.value = val;
      updateSliderLabels();
    }
  }

  function highlightBadges(containerSelector, currentVal, activeBgClass, activeTextClass) {
    document.querySelectorAll(containerSelector).forEach(btn => {
      const badge = btn.querySelector('.step-badge');
      const val = parseInt(badge.getAttribute('data-val'), 10);
      if (val === parseInt(currentVal, 10)) {
        badge.className = `step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-md ${activeBgClass} ${activeTextClass} scale-110 ring-2 ring-offset-1 dark:ring-offset-gray-800`;
      } else {
        badge.className = 'step-badge w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition shadow-sm bg-gray-100 dark:bg-gray-700/80 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600';
      }
    });
  }

  function updateSliderLabels() {
    const energy = document.getElementById('energy_level').value;
    const pain = document.getElementById('pain_level').value;
    const breath = document.getElementById('breathlessness').value;

    document.getElementById('energyValue').innerText = energyMap[energy] || energy;
    document.getElementById('painValue').innerText = painMap[pain] || pain;
    document.getElementById('breathValue').innerText = breathMap[breath] || breath;

    // Highlight active 1, 2, 3, 4, 5 numbered badges
    highlightBadges('.energy-step-btn', energy, 'bg-emerald-600 ring-emerald-400', 'text-white');
    highlightBadges('.pain-step-btn', pain, 'bg-rose-600 ring-rose-400', 'text-white');
    highlightBadges('.breath-step-btn', breath, 'bg-cyan-600 ring-cyan-400', 'text-white');

    // Header badge alert colors for acute symptoms
    const painValEl = document.getElementById('painValue');
    if (parseInt(pain, 10) >= 4) {
      painValEl.className = 'text-xs sm:text-sm font-bold px-3 py-1 rounded-xl bg-rose-100 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-300 dark:border-rose-900 shadow-sm';
    } else {
      painValEl.className = 'text-xs sm:text-sm font-bold px-3 py-1 rounded-xl bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600';
    }

    const breathValEl = document.getElementById('breathValue');
    if (parseInt(breath, 10) >= 4) {
      breathValEl.className = 'text-xs sm:text-sm font-bold px-3 py-1 rounded-xl bg-cyan-100 text-cyan-700 dark:bg-cyan-950/60 dark:text-cyan-300 border border-cyan-300 dark:border-cyan-900 shadow-sm';
    } else {
      breathValEl.className = 'text-xs sm:text-sm font-bold px-3 py-1 rounded-xl bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600';
    }
  }

  // Load today's checkin if already submitted
  async function checkTodayStatus() {
    try {
      const res = await fetch('/api/checkin/today');
      const data = await res.json();
      if (data.success && data.checkin) {
        const c = data.checkin;
        document.getElementById('energy_level').value = Math.max(1, c.energy_level || 3);
        document.getElementById('pain_level').value = Math.max(1, c.pain_level || 1);
        document.getElementById('breathlessness').value = Math.max(1, c.breathlessness || 1);
        document.getElementById('flare_flag').checked = Boolean(c.flare_flag);
        updateSliderLabels();

        const badge = document.getElementById('checkinBadge');
        badge.innerText = '✓ Completed Today (Edit anytime)';
        badge.className = 'text-xs font-semibold px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800';
      }
    } catch (e) {
      console.error(e);
    }
  }

  async function handleCheckinSubmit(e) {
    e.preventDefault();
    const energy_level = parseInt(document.getElementById('energy_level').value, 10);
    const pain_level = parseInt(document.getElementById('pain_level').value, 10);
    const breathlessness = parseInt(document.getElementById('breathlessness').value, 10);
    const flare_flag = document.getElementById('flare_flag').checked;

    const btn = document.getElementById('checkinBtn');
    btn.disabled = true;
    btn.innerHTML = '<span>Calibrating with Rule Engine...</span>';

    try {
      const res = await fetch('/api/checkin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ energy_level, pain_level, breathlessness, flare_flag })
      });
      const data = await res.json();

      if (data.success) {
        showToast('Symptom check-in saved! Generating workout...', 'success');
        setTimeout(() => {
          window.location.href = '/workout';
        }, 500);
      } else {
        showToast(data.error || 'Failed to save check-in', 'error');
        btn.disabled = false;
        btn.innerHTML = '<i data-lucide="sparkles" class="w-5 h-5"></i><span>Calibrate Today\'s Workout</span>';
        lucide.createIcons();
      }
    } catch (err) {
      showToast('Network error during check-in submission', 'error');
      btn.disabled = false;
      btn.innerHTML = '<i data-lucide="sparkles" class="w-5 h-5"></i><span>Calibrate Today\'s Workout</span>';
      lucide.createIcons();
    }
  }

  checkTodayStatus();
  updateSliderLabels();
</script>

<%- include('partials/footer') %>
