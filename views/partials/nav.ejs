<header class="sticky top-0 z-40 bg-white/90 dark:bg-gray-800/90 backdrop-blur-md border-b border-gray-200 dark:border-gray-700 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-brand-500/25 group-hover:scale-105 transition-transform">
          <i data-lucide="activity" class="w-6 h-6"></i>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-xl tracking-tight text-gray-900 dark:text-white">
            FitAdapt
          </span>
          <span class="text-[11px] text-gray-500 dark:text-gray-400 font-medium hidden sm:inline">Adaptive Fitness Companion</span>
        </div>
      </a>

      <!-- Desktop Nav Links (Hidden below md breakpoint - Section 9.2) -->
      <nav class="hidden md:flex items-center gap-7">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="text-sm font-medium text-gray-700 hover:text-brand-600 dark:text-gray-200 dark:hover:text-brand-400 transition-colors flex items-center gap-1.5 <%= typeof activeNav !== 'undefined' && activeNav === 'dashboard' ? 'text-brand-600 dark:text-brand-400 font-semibold' : '' %>">
            <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard
          </a>
          <a href="/checkin" class="text-sm font-medium text-gray-700 hover:text-brand-600 dark:text-gray-200 dark:hover:text-brand-400 transition-colors flex items-center gap-1.5 <%= typeof activeNav !== 'undefined' && activeNav === 'checkin' ? 'text-brand-600 dark:text-brand-400 font-semibold' : '' %>">
            <i data-lucide="clipboard-check" class="w-4 h-4"></i> Daily Check-in
          </a>
          <a href="/workout" class="text-sm font-medium text-gray-700 hover:text-brand-600 dark:text-gray-200 dark:hover:text-brand-400 transition-colors flex items-center gap-1.5 <%= typeof activeNav !== 'undefined' && activeNav === 'workout' ? 'text-brand-600 dark:text-brand-400 font-semibold' : '' %>">
            <i data-lucide="dumbbell" class="w-4 h-4"></i> Today's Workout
          </a>
          <a href="/exercises" class="text-sm font-medium text-gray-700 hover:text-brand-600 dark:text-gray-200 dark:hover:text-brand-400 transition-colors flex items-center gap-1.5 <%= typeof activeNav !== 'undefined' && activeNav === 'exercises' ? 'text-brand-600 dark:text-brand-400 font-semibold' : '' %>">
            <i data-lucide="library" class="w-4 h-4"></i> Exercise Library
          </a>
        <% } else { %>
          <a href="/#problem" class="text-sm font-medium text-gray-700 hover:text-brand-600 dark:text-gray-200 dark:hover:text-brand-400">Why FitAdapt</a>
          <a href="/#conditions" class="text-sm font-medium text-gray-700 hover:text-brand-600 dark:text-gray-200 dark:hover:text-brand-400">Conditions Supported</a>
          <a href="/exercises" class="text-sm font-medium text-gray-700 hover:text-brand-600 dark:text-gray-200 dark:hover:text-brand-400">Exercise Explorer</a>
        <% } %>
      </nav>

      <!-- Right Actions: Theme Toggle + User / Auth Buttons -->
      <div class="flex items-center gap-3">
        <!-- Dark/Light Mode Toggle Button (Section 9.1) -->
        <button onclick="toggleTheme()" aria-label="Toggle theme" class="p-2 rounded-xl text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-700 transition">
          <i data-lucide="sun" class="w-5 h-5 theme-icon-sun hidden text-amber-400"></i>
          <i data-lucide="moon" class="w-5 h-5 theme-icon-moon text-gray-600 dark:text-gray-300"></i>
        </button>

        <% if (typeof user !== 'undefined' && user) { %>
          <div class="hidden sm:flex items-center gap-3 pl-2 border-l border-gray-200 dark:border-gray-700">
            <a href="/onboarding" class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 flex items-center gap-1 hover:bg-emerald-100 transition" title="Edit Condition Profile">
              <i data-lucide="shield-plus" class="w-3.5 h-3.5"></i> Profile
            </a>
            <div class="text-xs text-gray-600 dark:text-gray-300 font-medium">
              <%= user.name.split(' ')[0] %>
            </div>
            <button onclick="logoutUser()" class="p-1.5 text-gray-400 hover:text-rose-600 dark:hover:text-rose-400 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition" title="Log Out">
              <i data-lucide="log-out" class="w-4 h-4"></i>
            </button>
          </div>
        <% } else { %>
          <div class="hidden sm:flex items-center gap-2">
            <a href="/login" class="text-sm font-medium px-4 py-2 rounded-xl text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 transition">Log In</a>
            <a href="/signup" class="text-sm font-medium px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white shadow-sm shadow-brand-600/30 transition">Get Started</a>
          </div>
        <% } %>

        <!-- Mobile Hamburger Button (Section 9.2) -->
        <button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-xl text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition" aria-label="Toggle menu">
          <i data-lucide="menu" class="w-6 h-6"></i>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Collapsible Nav Menu (Section 9.2) -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 pt-3 pb-5 space-y-2">
    <% if (typeof user !== 'undefined' && user) { %>
      <div class="px-2 py-1.5 mb-2 rounded-lg bg-gray-100 dark:bg-gray-700/60 flex items-center justify-between">
        <span class="text-xs font-semibold text-gray-700 dark:text-gray-200"><%= user.name %></span>
        <a href="/onboarding" class="text-xs text-brand-600 dark:text-brand-400 font-medium">Edit Profile</a>
      </div>
      <a href="/dashboard" class="block px-3 py-2 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">Dashboard</a>
      <a href="/checkin" class="block px-3 py-2 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">Daily Check-in</a>
      <a href="/workout" class="block px-3 py-2 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">Today's Workout</a>
      <a href="/exercises" class="block px-3 py-2 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">Exercise Library</a>
      <button onclick="logoutUser()" class="w-full text-left px-3 py-2 rounded-lg text-base font-medium text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40">Log Out</button>
    <% } else { %>
      <a href="/" class="block px-3 py-2 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">Home</a>
      <a href="/exercises" class="block px-3 py-2 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">Exercise Explorer</a>
      <a href="/login" class="block px-3 py-2 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">Log In</a>
      <a href="/signup" class="block px-3 py-2 text-center rounded-xl bg-brand-600 text-white font-medium shadow-sm">Get Started</a>
    <% } %>
  </div>
</header>

<script>
  async function logoutUser() {
    try {
      await fetch('/api/auth/logout', { method: 'POST' });
      localStorage.removeItem('token');
      window.location.href = '/login';
    } catch (e) {
      window.location.href = '/login';
    }
  }
</script>
