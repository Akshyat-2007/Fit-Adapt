<%- include('partials/header', { title: "Today's Adaptive Workout" }) %>
<%- include('partials/nav', { activeNav: 'workout' }) %>

<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
  
  <!-- Loading State -->
  <div id="loadingState" class="py-20 text-center space-y-4">
    <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-brand-500 border-t-transparent"></div>
    <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Calibrating your condition-safe routine with rule engine...</p>
  </div>

  <!-- Needs Check-in Banner -->
  <div id="needsCheckinCard" class="hidden max-w-2xl mx-auto p-8 rounded-3xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-xl text-center space-y-6">
    <div class="w-16 h-16 rounded-2xl bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-300 flex items-center justify-center mx-auto shadow-inner">
      <i data-lucide="clipboard-check" class="w-8 h-8"></i>
    </div>
    <div class="space-y-2">
      <h2 class="text-2xl font-black text-gray-900 dark:text-white">Daily Check-in Needed</h2>
      <p class="text-sm text-gray-600 dark:text-gray-300 max-w-md mx-auto">
        FitAdapt never guesses. To protect you against flare-ups, please share your energy, pain, and breathlessness levels for today first.
      </p>
    </div>
    <a href="/checkin" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold shadow-lg shadow-brand-600/30 transition">
      <span>Complete 30-Second Check-in</span>
      <i data-lucide="arrow-right" class="w-4 h-4"></i>
    </a>
  </div>

  <!-- Calibrated Workout View -->
  <div id="workoutContainer" class="hidden space-y-8">
    
    <!-- Top Header & Status Card -->
    <div class="bg-white dark:bg-gray-800 rounded-3xl p-6 sm:p-8 border border-gray-200 dark:border-gray-700 shadow-lg space-y-5">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">Calibrated for Today</span>
            <span id="conditionTag" class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 capitalize">
              Condition
            </span>
          </div>
          <h1 id="workoutTitle" class="text-3xl font-black text-gray-900 dark:text-white mt-1">Today's Adaptive Routine</h1>
        </div>

        <div class="flex items-center gap-3">
          <div id="intensityBadge" class="px-4 py-2 rounded-2xl font-extrabold text-sm uppercase tracking-wide flex items-center gap-2 shadow-sm">
            <!-- Dynamic intensity badge -->
          </div>
          <div id="completionStatusBadge">
            <!-- Dynamic completed badge -->
          </div>
        </div>
      </div>

      <!-- Adaptive Pacing & Clinical Rationale Card -->
      <div id="rationaleBox" class="p-4 rounded-2xl bg-brand-50/70 dark:bg-brand-950/40 border border-brand-200 dark:border-brand-800/80 flex items-start gap-3">
        <div class="p-2 rounded-xl bg-brand-100 dark:bg-brand-900/60 text-brand-600 dark:text-brand-300 shrink-0 mt-0.5">
          <i data-lucide="brain" class="w-5 h-5"></i>
        </div>
        <div class="space-y-1">
          <p class="text-xs font-bold uppercase tracking-wider text-brand-800 dark:text-brand-200 flex items-center gap-2">
            <span>Adaptive Logic Rationale</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-brand-200 dark:bg-brand-800 text-brand-800 dark:text-brand-100 font-medium">Condition-Calibrated Pacing</span>
          </p>
          <p id="rationaleText" class="text-xs sm:text-sm text-brand-900 dark:text-brand-100 leading-relaxed font-medium"></p>
        </div>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-center text-xs">
        <div class="p-2.5 rounded-xl bg-gray-50 dark:bg-gray-700/40 border border-gray-100 dark:border-gray-700">
          <span class="text-gray-400 block text-[10px] uppercase font-bold">Energy</span>
          <span id="metricEnergy" class="font-extrabold text-gray-800 dark:text-gray-200 text-sm">-</span>
        </div>
        <div class="p-2.5 rounded-xl bg-gray-50 dark:bg-gray-700/40 border border-gray-100 dark:border-gray-700">
          <span class="text-gray-400 block text-[10px] uppercase font-bold">Pain</span>
          <span id="metricPain" class="font-extrabold text-gray-800 dark:text-gray-200 text-sm">-</span>
        </div>
        <div class="p-2.5 rounded-xl bg-gray-50 dark:bg-gray-700/40 border border-gray-100 dark:border-gray-700">
          <span class="text-gray-400 block text-[10px] uppercase font-bold">Breathlessness</span>
          <span id="metricBreath" class="font-extrabold text-gray-800 dark:text-gray-200 text-sm">-</span>
        </div>
        <div class="p-2.5 rounded-xl bg-gray-50 dark:bg-gray-700/40 border border-gray-100 dark:border-gray-700">
          <span class="text-gray-400 block text-[10px] uppercase font-bold">Flare Active</span>
          <span id="metricFlare" class="font-extrabold text-gray-800 dark:text-gray-200 text-sm">-</span>
        </div>
      </div>
    </div>

    <!-- Section 9.2: Exercise Grid (grid-cols-1 sm:grid-cols-2 lg:grid-cols-3) -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
          <span>Assigned Exercises</span>
          <span id="exerciseCountBadge" class="text-xs font-semibold px-2 py-0.5 rounded-md bg-brand-100 text-brand-700 dark:bg-brand-900/60 dark:text-brand-300"></span>
        </h2>
        <a href="/checkin" class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline">
          Re-calibrate Check-in
        </a>
      </div>

      <div id="exerciseGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- Exercise cards dynamically injected -->
      </div>
    </div>

    <!-- Session Completion Action Card -->
    <div class="bg-white dark:bg-gray-800 rounded-3xl p-6 sm:p-8 border border-gray-200 dark:border-gray-700 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center sm:text-left">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Finished today's routine?</h3>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400">Logging completion adds to your consistency streak and updates your health history.</p>
      </div>
      <div class="flex items-center gap-3 w-full sm:w-auto">
        <button id="completeBtn" onclick="markWorkoutComplete()" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md shadow-emerald-600/30 transition flex items-center justify-center gap-2">
          <i data-lucide="check-circle-2" class="w-5 h-5"></i>
          <span>Mark Session as Complete</span>
        </button>
        <a href="/dashboard" class="w-full sm:w-auto px-5 py-3.5 rounded-xl bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 font-semibold text-sm transition text-center">
          Dashboard
        </a>
      </div>
    </div>

  </div>

</main>

<script>
  let currentWorkout = null;
  let sessionState = null;

  async function loadTodayWorkout() {
    try {
      const res = await fetch('/api/workout/today');
      const data = await res.json();

      document.getElementById('loadingState').classList.add('hidden');

      if (!data.success) {
        showToast(data.error || 'Failed to load workout', 'error');
        return;
      }

      if (data.needsCheckin) {
        document.getElementById('needsCheckinCard').classList.remove('hidden');
        lucide.createIcons();
        return;
      }

      currentWorkout = data.workout;
      sessionState = data.session;

      renderWorkout(currentWorkout, sessionState);
    } catch (err) {
      document.getElementById('loadingState').classList.add('hidden');
      showToast('Error loading workout routine', 'error');
    }
  }

  function renderWorkout(workout, session) {
    document.getElementById('workoutContainer').classList.remove('hidden');

    // Condition tag
    document.getElementById('conditionTag').innerText = (workout.conditionType || 'Custom') + ' • ' + (workout.severity || 'mild');

    // Intensity badge
    const badge = document.getElementById('intensityBadge');
    if (workout.intensity === 'rest') {
      badge.className = 'px-4 py-2 rounded-2xl font-extrabold text-xs uppercase tracking-wide flex items-center gap-1.5 bg-rose-100 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-900';
      badge.innerHTML = '<i data-lucide="bed" class="w-4 h-4"></i> Rest & Recovery Mode';
    } else if (workout.intensity === 'low') {
      badge.className = 'px-4 py-2 rounded-2xl font-extrabold text-xs uppercase tracking-wide flex items-center gap-1.5 bg-cyan-100 text-cyan-700 dark:bg-cyan-950/60 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-900';
      badge.innerHTML = '<i data-lucide="feather" class="w-4 h-4"></i> Gentle / Low Intensity';
    } else {
      badge.className = 'px-4 py-2 rounded-2xl font-extrabold text-xs uppercase tracking-wide flex items-center gap-1.5 bg-emerald-100 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900';
      badge.innerHTML = '<i data-lucide="flame" class="w-4 h-4"></i> Moderate Intensity';
    }

    // Completion Status
    const compBadge = document.getElementById('completionStatusBadge');
    const compBtn = document.getElementById('completeBtn');

    if (session && session.completed) {
      compBadge.innerHTML = '<span class="px-3 py-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 text-xs font-bold border border-emerald-200 dark:border-emerald-800 flex items-center gap-1"><i data-lucide="check" class="w-3.5 h-3.5"></i> Completed</span>';
      compBtn.classList.add('opacity-60', 'cursor-not-allowed');
      compBtn.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i> Completed Today';
      compBtn.disabled = true;
    } else {
      compBadge.innerHTML = '<span class="px-3 py-1.5 rounded-xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 text-xs font-bold border border-amber-200 dark:border-amber-800 flex items-center gap-1"><i data-lucide="clock" class="w-3.5 h-3.5"></i> Pending</span>';
    }

    // Rationale text
    document.getElementById('rationaleText').innerText = workout.rationale || workout.stateMessage;

    // Metrics strip
    document.getElementById('metricEnergy').innerText = workout.checkinSummary.energy + ' / 5';
    document.getElementById('metricPain').innerText = workout.checkinSummary.pain + ' / 5';
    document.getElementById('metricBreath').innerText = workout.checkinSummary.breathlessness + ' / 5';
    document.getElementById('metricFlare').innerText = workout.checkinSummary.flare ? 'Yes (Active)' : 'No';

    // Exercise count
    document.getElementById('exerciseCountBadge').innerText = workout.exercises.length + ' movements';

    // Exercise Cards (Section 9.2 spec)
    const grid = document.getElementById('exerciseGrid');
    grid.innerHTML = '';

    workout.exercises.forEach((ex, idx) => {
      const card = document.createElement('div');
      card.className = 'bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-md p-5 flex flex-col justify-between hover:border-brand-300 dark:hover:border-brand-700 transition group';
      
      const intensityColor = ex.intensity === 'low' ? 'bg-cyan-50 text-cyan-700 dark:bg-cyan-950/50 dark:text-cyan-300' : 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300';

      card.innerHTML = `
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold px-2 py-0.5 rounded-md ${intensityColor} uppercase tracking-wider">
              ${ex.intensity} intensity
            </span>
            <span class="text-xs text-gray-400 font-medium">#0${idx + 1}</span>
          </div>

          <div>
            <h3 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
              ${ex.name}
            </h3>
            <span class="text-xs font-medium text-brand-600 dark:text-brand-400 block mt-0.5">
              Target: ${ex.target_muscle || 'Full Body'}
            </span>
          </div>

          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
            ${ex.description}
          </p>
        </div>

        <div class="pt-4 mt-4 border-t border-gray-100 dark:border-gray-700 flex items-center justify-between gap-2">
          <button onclick="openVideoModal('${ex.video_url}', '${ex.name.replace(/'/g, "\\'")}', '${ex.description.replace(/'/g, "\\'")}')" class="px-3 py-1.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold shadow-sm transition flex items-center gap-1.5">
            <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i>
            <span>Technique Video</span>
          </button>
          
          <a href="${(parseYouTubeUrls ? parseYouTubeUrls(ex.video_url).watchUrl : ex.video_url)}" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1.5 rounded-xl bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 text-xs font-semibold transition flex items-center gap-1" title="Watch on YouTube">
            <i data-lucide="external-link" class="w-3 h-3 text-red-500"></i>
            <span>YouTube</span>
          </a>
        </div>
      `;

      grid.appendChild(card);
    });

    lucide.createIcons();
  }

  async function markWorkoutComplete() {
    const btn = document.getElementById('completeBtn');
    btn.disabled = true;
    btn.innerHTML = '<span>Recording progress...</span>';

    try {
      const res = await fetch('/api/session/complete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      });
      const data = await res.json();

      if (data.success) {
        showToast('Workout marked as complete! Consistency streak increased 🔥', 'success');
        setTimeout(() => {
          window.location.href = '/dashboard';
        }, 1000);
      } else {
        showToast(data.error || 'Failed to complete session', 'error');
        btn.disabled = false;
        btn.innerHTML = '<i data-lucide="check-circle-2" class="w-5 h-5"></i><span>Mark Session as Complete</span>';
        lucide.createIcons();
      }
    } catch (err) {
      showToast('Network error while completing session', 'error');
      btn.disabled = false;
      btn.innerHTML = '<i data-lucide="check-circle-2" class="w-5 h-5"></i><span>Mark Session as Complete</span>';
      lucide.createIcons();
    }
  }

  loadTodayWorkout();
</script>

<%- include('partials/footer') %>
