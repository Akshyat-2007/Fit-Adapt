{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{views/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-pacing",
      "schedule": "0 0 * * *"
    }
  ]
}
